# Joins upstream Wi-Fi networks on one radio, e.g. rasbeacon-wpa@wlan0.service.
# Started and restarted by rbd after it writes /run/rbd/wpa_supplicant.conf;
# not started on its own at boot.
[Unit]
Description=RasBeacon Wi-Fi uplink on %i (wpa_supplicant)
After=rbd.service
BindsTo=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device

[Service]
# No -d (debug) option: debug output could include network passwords.
ExecStart=/usr/sbin/wpa_supplicant -i %i -c /run/rbd/wpa_supplicant.conf -D nl80211
Restart=on-failure
RestartSec=2
# Sandboxing: it reads what any device in radio range sends, so a flaw in
# it must reach as little as possible. It keeps root's user (its control
# sockets are root's) but only the capabilities a Wi-Fi daemon uses, sees
# /usr, /etc and /boot read-only, and gets no device but rfkill. No
# PrivateTmp: wpa_cli and hostapd_cli, which rbd runs, wait for answers on
# sockets in /tmp (see rbd.service). Filtered system calls fail with EPERM
# instead of ending it.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
ProtectSystem=full
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
DevicePolicy=closed
DeviceAllow=/dev/rfkill rw
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_PACKET AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
