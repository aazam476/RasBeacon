# rbd: RasBeacon's privileged background program (see cmd/rbd).
[Unit]
Description=RasBeacon network agent (rbd)
# The lockdown firewall must be in place first.
Requires=rasbeacon-firewall-early.service
After=rasbeacon-firewall-early.service network-pre.target systemd-udevd.service
# rbd keeps settings on /persistent and reads setup.txt from /bootfs.
RequiresMountsFor=/persistent /bootfs

[Service]
ExecStart=/usr/bin/rbd
Restart=always
RestartSec=3
# rbd must run as root to change network settings. Limit what else it can do.
ProtectHome=yes
# No PrivateTmp: wpa_cli and hostapd_cli, which rbd runs, create their reply
# socket in /tmp, and wpa_supplicant and hostapd must be able to answer it
# there. With a private /tmp every command times out (exit status 254).

[Install]
WantedBy=multi-user.target
