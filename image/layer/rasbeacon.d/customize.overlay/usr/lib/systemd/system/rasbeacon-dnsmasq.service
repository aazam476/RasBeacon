# DHCP and DNS for devices on the hotspot. Started and restarted by rbd after
# it writes /run/rbd/dnsmasq.conf. dnsmasq drops to the "nobody" user after
# opening its files.
[Unit]
Description=RasBeacon DHCP and DNS (dnsmasq)
After=rbd.service

[Service]
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/run/rbd/dnsmasq.conf --pid-file= --user=nobody --group=nogroup --log-facility=-
Restart=on-failure
RestartSec=2
# Sandboxing: it answers every device on the hotspot and the guest
# network, so a flaw in it must reach as little as possible. It starts as
# root to open its ports and files, then becomes "nobody" keeping only the
# network capabilities (see --user above); the bounding set is what that
# needs. It sees /usr, /etc and /boot read-only (its files are in /run/rbd),
# a /tmp and /dev of its own, and can't change kernel settings. Filtered
# system calls fail with EPERM instead of ending it.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_CHOWN
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_PACKET AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
