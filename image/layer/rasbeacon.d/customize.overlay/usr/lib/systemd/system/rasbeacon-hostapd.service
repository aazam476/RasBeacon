# The Wi-Fi hotspot. Started and restarted by rbd after it writes
# /run/rbd/hostapd.conf; not started on its own at boot.
[Unit]
Description=RasBeacon hotspot (hostapd)
After=rbd.service

[Service]
# GUEST_CONF names the guest network's own file when it has a radio of its
# own (rbd writes hostapd.env); one hostapd then runs both radios.
EnvironmentFile=-/run/rbd/hostapd.env
ExecStart=/usr/sbin/hostapd /run/rbd/hostapd.conf $GUEST_CONF
Restart=on-failure
RestartSec=2
