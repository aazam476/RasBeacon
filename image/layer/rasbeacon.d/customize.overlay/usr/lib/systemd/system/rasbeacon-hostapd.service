# The Wi-Fi hotspot. Started and restarted by rbd after it writes
# /run/rbd/hostapd.conf; not started on its own at boot.
[Unit]
Description=RasBeacon hotspot (hostapd)
After=rbd.service

[Service]
# GUEST_CONF names the guest network's own file when it has a radio of its
# own (rbd writes hostapd.env); one hostapd then runs both radios.
EnvironmentFile=-/run/rbd/hostapd.env
ExecStart=/usr/sbin/hostapd /run/rbd/hostapd.conf $GUEST_CONF
Restart=on-failure
RestartSec=2
# Sandboxing: it reads what any device in radio range sends, so a flaw in
# it must reach as little as possible. It keeps root's user (its control
# sockets are root's) but only the capabilities a Wi-Fi daemon uses, sees
# /usr, /etc and /boot read-only, and gets no device but rfkill. No
# PrivateTmp: wpa_cli and hostapd_cli, which rbd runs, wait for answers on
# sockets in /tmp (see rbd.service). Filtered system calls fail with EPERM
# instead of ending it.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
ProtectSystem=full
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
DevicePolicy=closed
DeviceAllow=/dev/rfkill rw
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_PACKET AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
