# dnsmasq configuration for the RasBeacon hotspot.
# GENERATED by rbd from internal/render/templates/dnsmasq.conf.tmpl.
#
# dnsmasq does two jobs for devices on the hotspot:
#   DHCP - hands each device an IP address when it joins
#   DNS  - turns names like "rasbeacon.lan" into addresses
# Reference: https://thekelleys.org.uk/dnsmasq/docs/dnsmasq-man.html

# --- Only serve the hotspot side, never the upstream network ---
interface={{.Bridge}}
bind-interfaces
# Don't read /etc/resolv.conf or /etc/hosts: everything is configured here.
no-resolv
no-hosts

# --- DHCP: addresses for connected devices ---
# Leases last 1 hour, so devices using private/rotating MAC addresses free
# their old address quickly.
dhcp-range={{.DHCPStart}},{{.DHCPEnd}},{{.Netmask}},1h
dhcp-leasefile={{.LeaseFile}}
# Tell devices to use RasBeacon as their router and DNS server.
dhcp-option=option:router,{{.LANAddress}}
dhcp-option=option:dns-server,{{.LANAddress}}
# Answer DHCP requests immediately even for devices we have not seen before.
dhcp-authoritative

# --- DNS: local names ---
domain=lan
local=/lan/
address=/rasbeacon.lan/{{.LANAddress}}
{{- if and (not .Captive) .Upstream}}

# --- DNS: internet names ---
# Questions about any other name are passed on to these servers.
# 127.0.0.53 is RasBeacon's own resolver (systemd-resolved), which asks the
# DNS servers the current uplink (hotel, café, ...) handed out.
{{- range .Upstream}}
server={{.}}
{{- end}}
{{- end}}
{{- if .IPv6}}

# --- IPv6 for devices ---
# RasBeacon announces a private IPv6 network ("router advertisements").
# Devices pick their own addresses in it (SLAAC); no DHCPv6 is used, which is
# also what Android requires.
enable-ra
dhcp-range=::,constructor:{{.Bridge}},ra-only,64,1h
# Tell devices to use RasBeacon for DNS over IPv6 too ([::] = this device).
dhcp-option=option6:dns-server,[::]
{{- if .IPv6DefaultRoute}}
# The uplink has IPv6, so devices may send IPv6 internet traffic here.
# Announce every 60 s; devices keep the route for 30 minutes.
ra-param={{.Bridge}},60,1800
{{- else}}
# No IPv6 internet path right now: "router lifetime 0" means "I am not a
# router for IPv6". Devices keep their local IPv6 addresses but use IPv4 for
# the internet instead of waiting for IPv6 to time out.
ra-param={{.Bridge}},10,0
{{- end}}
{{- end}}
{{- if .NoticeHostnames}}

# --- The uplink needs a login (captive portal) ---
# Devices' own "is there internet?" checks get RasBeacon's address, so their
# "Log in to network" sheet opens RasBeacon's notice page, where the owner
# can start login mode.
{{- range .NoticeHostnames}}
address=/{{.}}/{{$.LANAddress}}
{{- end}}
# RFC 8910: tell devices directly where the notice page is.
dhcp-option=114,"{{.CaptivePortalAPI}}"
{{- end}}
{{- if .Captive}}

# --- Setup mode: send every device to the setup page ---
# Every name resolves to RasBeacon itself, so when a phone checks for
# internet access (for example captive.apple.com), it reaches the setup page
# and shows its "Log in to network" screen automatically.
address=/#/{{.LANAddress}}
# Answer every other question (like IPv6 "AAAA" lookups) here with "no such
# address", instead of refusing it, so phones cleanly fall back to IPv4.
local=/#/
# RFC 8910: tell modern phones directly where the setup page is.
dhcp-option=114,"{{.CaptivePortalAPI}}"
{{- end}}
