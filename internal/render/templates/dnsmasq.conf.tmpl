# dnsmasq configuration for the RasBeacon hotspot.
# GENERATED by rbd from internal/render/templates/dnsmasq.conf.tmpl.
#
# dnsmasq does two jobs for devices on the hotspot:
#   DHCP - hands each device an IP address when it joins
#   DNS  - turns names like "rasbeacon.lan" into addresses
# Reference: https://thekelleys.org.uk/dnsmasq/docs/dnsmasq-man.html

# --- Only serve the hotspot side, never the upstream network ---
interface={{.Bridge}}
bind-interfaces
# Don't read /etc/resolv.conf or /etc/hosts: everything is configured here.
no-resolv
no-hosts

# --- DHCP: addresses for connected devices ---
# Leases last 1 hour, so devices using private/rotating MAC addresses free
# their old address quickly.
dhcp-range={{.DHCPStart}},{{.DHCPEnd}},{{.Netmask}},1h
dhcp-leasefile={{.LeaseFile}}
# Tell devices to use RasBeacon as their router and DNS server.
dhcp-option=option:router,{{.LANAddress}}
dhcp-option=option:dns-server,{{.LANAddress}}
# Answer DHCP requests immediately even for devices we have not seen before.
dhcp-authoritative

# --- DNS: local names ---
domain=lan
local=/lan/
address=/rasbeacon.lan/{{.LANAddress}}
{{- if .Captive}}

# --- Setup mode: send every device to the setup page ---
# Every name resolves to RasBeacon itself, so when a phone checks for
# internet access (for example captive.apple.com), it reaches the setup page
# and shows its "Log in to network" screen automatically.
address=/#/{{.LANAddress}}
# RFC 8910: tell modern phones directly where the setup page is.
dhcp-option=114,"{{.CaptivePortalAPI}}"
{{- end}}
