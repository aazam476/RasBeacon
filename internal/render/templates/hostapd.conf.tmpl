# hostapd configuration for the RasBeacon hotspot.
# GENERATED by rbd from internal/render/templates/hostapd.conf.tmpl.
# Do not edit on the device: it is rewritten every time settings change.
#
# hostapd is the program that turns a Wi-Fi adapter into an access point.
# Reference: https://w1.fi/cgit/hostap/plain/hostapd/hostapd.conf

# --- Which radio, and how rbd talks to hostapd ---
interface={{.Interface}}
# Put the hotspot into the "br-lan" bridge. The bridge holds the hotspot's
# IP address, so Wi-Fi clients (and, later, a wired client port) share one
# network.
bridge={{.Bridge}}
driver=nl80211
# rbd and the status page read connected devices through this socket.
ctrl_interface=/run/hostapd
ctrl_interface_group=0

# --- Network name ---
# The name is written in hexadecimal ("ssid2") so any characters the owner
# chose, including quotes or emoji, cannot break this file.
# Name: {{.SSIDForComment}}
ssid2={{.SSIDHex}}
utf8_ssid=1

# --- Country and radio settings ---
# The country decides which channels and power levels are legal.
# ieee80211d=1 announces the country to connecting devices.
country_code={{.Country}}
ieee80211d=1
{{- if eq .Band "5GHz"}}
# 5 GHz: faster, shorter range. Channel {{.Channel}} needs no radar detection.
hw_mode=a
channel={{.Channel}}
ieee80211n=1
ieee80211ac=1
{{- if .VHT80}}
# Use 80 MHz wide channels (802.11ac) centred on channel {{.VHTCenterChannel}}.
# {{.HT40Direction}} says whether the 40 MHz partner channel is above (+) or
# below (-) channel {{.Channel}}.
ht_capab=[{{.HT40Direction}}][SHORT-GI-40]
vht_oper_chwidth=1
vht_oper_centr_freq_seg0_idx={{.VHTCenterChannel}}
{{- else}}
# Channel {{.Channel}} cannot be combined into a wider channel, so it uses
# 20 MHz.
vht_oper_chwidth=0
{{- end}}
{{- else}}
# 2.4 GHz: longer range and supported by every device.
hw_mode=g
channel={{.Channel}}
ieee80211n=1
{{- end}}
# WMM (Wi-Fi Multimedia) is required for Wi-Fi 4/5 speeds.
wmm_enabled=1

# --- Who can connect ---
# Devices on the hotspot may talk to each other (AirPlay, printers, ...).
ap_isolate=0
auth_algs=1
{{- if .AcceptMACFile}}
# Only the devices on the owner's list may join (Settings: Hotspot, Allowed
# devices). Devices on Ethernet don't go through hostapd, so they always can.
macaddr_acl=1
accept_mac_file={{.AcceptMACFile}}
{{- end}}
{{- if .MaxDevices}}
# The most devices connected at once.
max_num_sta={{.MaxDevices}}
{{- end}}
{{- if .Open}}
# OPEN network: no password. This is only used for the first-boot setup
# network when no setup.txt was provided, and it closes after setup.
{{- else}}
# WPA2/WPA3 password protection with AES (CCMP) encryption.
wpa=2
rsn_pairwise=CCMP
{{- if eq .Security "wpa2-wpa3"}}
# Transition mode: WPA3 (SAE) for devices that support it, WPA2 (PSK) for
# the rest. Protected Management Frames are optional (1) so WPA2 devices can
# still join, but required for WPA3 devices (sae_require_mfp=1).
wpa_key_mgmt=WPA-PSK SAE
ieee80211w=1
sae_require_mfp=1
# Allow both WPA3 password methods (hunting-and-pecking and hash-to-element).
sae_pwe=2
{{- else if eq .Security "wpa3"}}
# WPA3 only (SAE): the safest; devices without WPA3 can't join. Protected
# Management Frames are required (2).
wpa_key_mgmt=SAE
ieee80211w=2
sae_pwe=2
{{- else}}
# WPA2 only: a compatibility setting for old devices.
wpa_key_mgmt=WPA-PSK
ieee80211w=0
{{- end}}
wpa_passphrase={{.Password}}
# Keep the network-wide ("group") key instead of changing it every day.
# Some Wi-Fi adapters and phones miss the change: they stay connected but
# no longer receive broadcast messages, such as RasBeacon asking where a
# device is (ARP), so Wi-Fi devices lose the internet while Ethernet
# devices keep it. A new group key is still made whenever the hotspot
# starts, and each device keeps its own key for everything else.
wpa_group_rekey=0
{{- end}}
{{- if .Guest}}

# ===== Guest network =====
# A second network name on the same radio, for visitors. Everything above
# (band, channel, country) also applies here; the settings below only
# change what differs. hostapd creates the interface "{{.GuestInterface}}".
bss={{.GuestInterface}}
# Its own MAC address (every network on a radio needs one).
bssid={{.Guest.BSSID}}
# A separate bridge with its own addresses. The firewall lets guests reach
# the internet and RasBeacon's DHCP and DNS, nothing else.
bridge={{.GuestBridge}}
ctrl_interface=/run/hostapd
ctrl_interface_group=0
# Name: {{.GuestSSIDForComment}}
ssid2={{.GuestSSIDHex}}
utf8_ssid=1
# Guests can't talk to each other.
ap_isolate=1
auth_algs=1
{{- if .MaxDevices}}
max_num_sta={{.MaxDevices}}
{{- end}}
wpa=2
rsn_pairwise=CCMP
{{- if eq .Security "wpa2-wpa3"}}
wpa_key_mgmt=WPA-PSK SAE
ieee80211w=1
sae_require_mfp=1
sae_pwe=2
{{- else if eq .Security "wpa3"}}
wpa_key_mgmt=SAE
ieee80211w=2
sae_pwe=2
{{- else}}
wpa_key_mgmt=WPA-PSK
ieee80211w=0
{{- end}}
wpa_passphrase={{.Guest.Password}}
wpa_group_rekey=0
{{- end}}
