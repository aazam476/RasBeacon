# systemd-networkd settings for the uplink {{.Interface}}.
# GENERATED by rbd from internal/render/templates/uplink.network.tmpl.
#
# Gets an address from the upstream network (hotel, café, ...). The file
# name starts with "00-" so it is chosen before the image's default files.
# Reference: https://www.freedesktop.org/software/systemd/man/latest/systemd.network.html

[Match]
Name={{.Interface}}

[Network]
# IPv4 address by DHCP; IPv6 address from router advertisements.
DHCP=ipv4
IPv6AcceptRA=yes
LinkLocalAddressing=ipv6
# Don't announce RasBeacon by name on networks we don't control.
LLMNR=no
MulticastDNS=no

[DHCPv4]
# Lower numbers win when several uplinks are connected (Ethernet first).
RouteMetric={{.RouteMetric}}
# Don't tell the upstream network RasBeacon's name.
SendHostname=no
# Use the hardware address as the DHCP client ID, which some hotel login
# systems expect.
ClientIdentifier=mac

[IPv6AcceptRA]
RouteMetric={{.RouteMetric}}
