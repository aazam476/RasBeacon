#!/usr/sbin/nft -f
# RasBeacon firewall rules.
# GENERATED by rbd from internal/render/templates/firewall.nft.tmpl.
#
# How to read this file:
#   - nftables checks each packet against the rules in a chain, top to bottom.
#   - "accept" lets the packet through; "drop" silently discards it.
#   - "policy drop" means: if no rule matched, drop the packet. So anything
#     not explicitly allowed below is blocked.
#   - "table inet" covers both IPv4 and IPv6 with one set of rules.
#
# The whole file is loaded in one step (one transaction): the old rules are
# replaced by the new ones instantly, with no moment where neither applies.

# Replace any previous version of our table. Creating it first (empty) and
# then deleting it makes this work whether or not the table already exists.
table inet rasbeacon
delete table inet rasbeacon

table inet rasbeacon {
{{- if .Egress}}
	# Where devices' traffic may leave RasBeacon: the uplinks (Ethernet,
	# Wi-Fi), or only the VPN tunnel when the VPN is in use.
	set egress {
		type ifname
		elements = { {{range $i, $name := .Egress}}{{if $i}}, {{end}}"{{$name}}"{{end}} }
	}
{{end}}
	# The networks devices connect to: your hotspot ("{{.Bridge}}"){{if .Guest}}
	# and the guest network ("{{.GuestBridge}}"){{end}}. Both may reach the
	# internet the same way; only yours may reach RasBeacon's settings.
	set lans {
		type ifname
		elements = { "{{.Bridge}}"{{if .Guest}}, "{{.GuestBridge}}"{{end}} }
	}

	# INPUT: packets addressed to RasBeacon itself.
	chain input {
		type filter hook input priority filter; policy drop;

		# Traffic from RasBeacon to itself (for example rbweb talking to rbd).
		iif "lo" accept

		# Replies to connections RasBeacon started are allowed back in.
		ct state established,related accept
		ct state invalid drop

		# IPv6 neighbor discovery and basic ICMP are needed for networking to
		# work at all (and "ping" helps troubleshooting).
		meta l4proto ipv6-icmp accept
		icmp type { echo-request, destination-unreachable, time-exceeded } accept

		# DHCP answers to RasBeacon's own address requests: on the uplinks,
		# and for the Ethernet client-port safety check. Only the DHCP client
		# listens on port 68.
		udp sport 67 udp dport 68 accept

		# --- From devices on the hotspot ("{{.Bridge}}") ---
		# DHCP: devices asking for an IP address.
		iifname "{{.Bridge}}" udp dport 67 accept
		# DNS: devices looking up names.
		iifname "{{.Bridge}}" meta l4proto { tcp, udp } th dport 53 accept
		# Web UI (HTTP and HTTPS). Only reachable from the hotspot side.
		iifname "{{.Bridge}}" tcp dport { 80, 443 } accept
{{- if .SSHEnabled}}
		# SSH was turned on in the web UI (hotspot side only).
		iifname "{{.Bridge}}" tcp dport 22 accept
{{- end}}
{{- if .Guest}}

		# --- From the guest network ("{{.GuestBridge}}") ---
		# Only DHCP and DNS. Everything else (the web UI, SSH) is refused
		# straight away ("reject"), so guests' phones don't wait for it.
		iifname "{{.GuestBridge}}" udp dport 67 accept
		iifname "{{.GuestBridge}}" meta l4proto { tcp, udp } th dport 53 accept
		iifname "{{.GuestBridge}}" reject
{{- end}}

		# --- From plugins ("{{.PluginBridge}}") ---
		# Plugins that may use the internet may ask RasBeacon's DNS server.
		# Nothing else on RasBeacon answers them (not these settings).
{{- if .PluginInternet}}
		iifname "{{.PluginBridge}}" ip saddr { {{range $i, $a := .PluginInternet}}{{if $i}}, {{end}}{{$a}}{{end}} } ip daddr {{.PluginGateway}} meta l4proto { tcp, udp } th dport 53 accept
{{- end}}
		iifname "{{.PluginBridge}}" reject

		# Everything else is dropped by the policy above. In particular,
		# nothing from the upstream network can reach the web UI or SSH.
	}

	# FORWARD: packets passing THROUGH RasBeacon (from a device to the
	# internet). Anything not allowed here is dropped.
	chain forward {
		type filter hook forward priority filter; policy drop;
{{- if or .PluginPorts .PluginLAN}}

		# Plugins: devices on your hotspot may reach the ports you gave them
		# (see plugin_ports below), and the plugins may answer. Guests and
		# the internet can't reach them.
{{- if .PluginPorts}}
		iifname "{{.Bridge}}" oifname "{{.PluginBridge}}" ct status dnat accept
{{- end}}
		iifname "{{.PluginBridge}}" oifname "{{.Bridge}}" ct state established,related accept
{{- end}}
{{- if .PluginLAN}}
		# Plugins allowed to reach your devices (not guests).
		iifname "{{.PluginBridge}}" ip saddr { {{range $i, $a := .PluginLAN}}{{if $i}}, {{end}}{{$a}}{{end}} } oifname "{{.Bridge}}" accept
{{- end}}
{{- if .Egress}}

		# Make new TCP connections use packets small enough for every link on
		# the way ("MSS clamping"). Without this, some websites hang on hotel
		# networks and tunnels that use smaller packets.
		tcp flags syn tcp option maxseg size set rt mtu

		ct state invalid drop
{{- if .PausedMACs}}

		# Devices whose internet access the owner paused: nothing from them
		# is forwarded (they can still reach RasBeacon itself).
		iifname @lans ether saddr { {{range $i, $m := .PausedMACs}}{{if $i}}, {{end}}{{$m}}{{end}} } reject
{{- end}}
{{- if or .PausedIPv4 .PausedIPv6}}
		# ... and nothing reaches them from outside, not even answers to
		# connections they started before.
{{- end}}
{{- if .PausedIPv4}}
		oifname @lans ip daddr { {{range $i, $a := .PausedIPv4}}{{if $i}}, {{end}}{{$a}}{{end}} } drop
{{- end}}
{{- if .PausedIPv6}}
		oifname @lans ip6 daddr { {{range $i, $a := .PausedIPv6}}{{if $i}}, {{end}}{{$a}}{{end}} } drop
{{- end}}

		# Connections devices already started may continue, but only on the
		# current path. When the path changes (for example from login mode
		# back to the VPN), connections on the old path stop at once instead
		# of carrying on outside the tunnel.
		iifname @lans oifname @egress ct state established,related accept
		iifname @egress oifname @lans ct state established,related accept
		iifname "{{.PluginBridge}}" oifname @egress ct state established,related accept
		iifname @egress oifname "{{.PluginBridge}}" ct state established,related accept
{{- if .PortalOnly}}

		# LOGIN MODE (captive portal): for a few minutes, devices may reach
		# the network's login page directly: web (TCP 80 and 443) and DNS
		# only. Everything else stays blocked.
		iifname @lans oifname @egress tcp dport { 80, 443 } accept
		iifname @lans oifname @egress meta l4proto { tcp, udp } th dport 53 accept
{{- else}}

		# Devices on the hotspot{{if .Guest}} and guests{{end}} may reach the internet, only
		# through the interfaces in "egress". Nothing from outside may start
		# a connection to a device{{if .Guest}}, and the two networks can't reach
		# each other{{end}}.
		iifname @lans oifname @egress accept
{{- if .PluginInternet}}
		# Plugins that may use the internet: the same way as your devices
		# (through the VPN when it is in use). Not in login mode above.
		iifname "{{.PluginBridge}}" ip saddr { {{range $i, $a := .PluginInternet}}{{if $i}}, {{end}}{{$a}}{{end}} } oifname @egress accept
{{- end}}
{{- end}}
{{- else}}
		# Nothing is forwarded (for example during first-boot setup).
{{- end}}
	}

	# DNS: devices that ignore RasBeacon's DNS server (some phones, smart TVs)
	# are sent to it anyway, so every name lookup follows RasBeacon's rules.
	# Also during first-time setup, without any uplink: then RasBeacon's
	# answers are what make a phone open the setup page by itself.
	chain prerouting_nat {
		type nat hook prerouting priority dstnat;
		iifname @lans meta l4proto { tcp, udp } th dport 53 redirect
	}
{{- if .Egress}}

	# NAT ("masquerade"): devices' traffic gets RasBeacon's own address as
	# its sender, so the network outside only ever sees one device. This
	# covers IPv4 and IPv6 ("NAT66").
	chain postrouting_nat {
		type nat hook postrouting priority srcnat;
{{- if .RoutedIPv6}}
		# Except: devices' public IPv6 addresses, from the network the VPN
		# server routes to RasBeacon ({{.RoutedIPv6}}), go through the tunnel
		# unchanged ("accept" here means "no NAT").
		oifname "{{.TunnelInterface}}" ip6 saddr {{.RoutedIPv6}} accept
{{- end}}
		oifname @egress masquerade
	}
{{- end}}

{{- if .PluginPorts}}

	# Plugins' ports: a device on your hotspot reaches a plugin at
	# RasBeacon's address and the port you chose for it.
	chain plugin_ports {
		type nat hook prerouting priority dstnat;
{{- range .PluginPorts}}
		iifname "{{$.Bridge}}" ip daddr {{$.LANAddress}} {{.Protocol}} dport {{.Host}} dnat ip to {{.Address}}:{{.Container}}
{{- end}}
	}
{{- end}}

	# OUTPUT: packets RasBeacon itself sends. Allowed, except:
	chain output {
		type filter hook output priority filter; policy accept;
{{- with .Browser}}
		# The login browser (user number {{.UID}}, see internal/browser) may
		# only ask RasBeacon's own name resolver and reach the hotel network
		# directly: not the VPN, not your devices, not RasBeacon's web UI.
		meta skuid {{.UID}} oifname "lo" ip daddr 127.0.0.53 meta l4proto { tcp, udp } th dport 53 accept
{{- if .Uplinks}}
		meta skuid {{.UID}} oifname != { {{range $i, $name := .Uplinks}}{{if $i}}, {{end}}"{{$name}}"{{end}} } reject
{{- else}}
		meta skuid {{.UID}} reject
{{- end}}
{{- end}}
{{- if .TunnelDNS4}}
		# The VPN's DNS servers may only be reached through the tunnel, so
		# devices' name lookups never leak to the uplink.
		ip daddr { {{range $i, $a := .TunnelDNS4}}{{if $i}}, {{end}}{{$a}}{{end}} } oifname != "{{.TunnelInterface}}" reject
{{- end}}
{{- if .TunnelDNS6}}
		ip6 daddr { {{range $i, $a := .TunnelDNS6}}{{if $i}}, {{end}}{{$a}}{{end}} } oifname != "{{.TunnelInterface}}" reject
{{- end}}
	}
}

# Plugins all plug into one bridge ("{{.PluginBridge}}"), each with its own
# port ("{{.PluginBridgePorts}}"). Packets between two ports of a bridge are
# passed along by the bridge itself and never reach the table above, so
# without this one any plugin could reach every other plugin, whatever its
# permissions. The "forward" hook of a bridge table sees exactly those
# packets (not the ones to RasBeacon itself), so dropping every one that
# came in on a plugin's port leaves each plugin only what the rules above
# allow it: RasBeacon itself, and (with permission) the internet and your
# devices. Replaced the same way as the table above.
table bridge rasbeacon
delete table bridge rasbeacon

table bridge rasbeacon {
	chain forward {
		type filter hook forward priority filter; policy accept;
		iifname "{{.PluginBridgePorts}}" drop
	}
}
