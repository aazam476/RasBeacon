# systemd-networkd settings for the uplink {{.Interface}}.
# GENERATED by rbd from internal/render/templates/static.network.tmpl.
#
# A mobile broadband modem's data connection: the modem tells RasBeacon the
# address, gateway and DNS servers its network gave it (there is no DHCP
# server on this link).
# Reference: https://www.freedesktop.org/software/systemd/man/latest/systemd.network.html

[Match]
Name={{.Interface}}
{{- if .MTU}}

[Link]
MTUBytes={{.MTU}}
{{- end}}

[Network]
Address={{.Address}}
{{- range .DNS}}
DNS={{.}}
{{- end}}
LinkLocalAddressing=no
IPv6AcceptRA=no
# Don't announce RasBeacon by name on networks we don't control.
LLMNR=no
MulticastDNS=no

[Route]
Gateway={{.Gateway}}
# The gateway may be outside the address's small network.
GatewayOnLink=yes
# Lower numbers win when several uplinks are connected (Ethernet first).
Metric={{.RouteMetric}}
