# wpa_supplicant configuration for RasBeacon's Wi-Fi uplink.
# GENERATED by rbd from internal/render/templates/wpa_supplicant.conf.tmpl.
# Do not edit on the device: it is rewritten every time settings change.
#
# wpa_supplicant is the program that joins Wi-Fi networks (like the Wi-Fi
# menu on a laptop). Reference:
# https://w1.fi/cgit/hostap/plain/wpa_supplicant/wpa_supplicant.conf

# rbd reads the connection state and scan results through this socket.
ctrl_interface=DIR=/run/wpa_supplicant
# Never write anything back into this file.
update_config=0
# The country decides which channels and power levels are legal.
country={{.Country}}
# Allow both WPA3 password methods (hunting-and-pecking and hash-to-element).
sae_pwe=2
{{- range .Networks}}

# Name: {{.SSIDForComment}}
network={
	# The name is written in hexadecimal so any characters, including
	# quotes, cannot break this file.
	ssid={{.SSIDHex}}
	# Higher numbers are joined first when several networks are in range.
	priority={{.Priority}}
{{- if .Hidden}}
	# Hidden network: ask for it by name while scanning.
	scan_ssid=1
{{- end}}
{{- if eq .Security "open"}}
	# Open network: no password.
	key_mgmt=NONE
{{- else}}
	# WPA2-Personal or WPA3-Personal, whichever the network offers (best
	# first). Protected Management Frames are used when available.
	key_mgmt=WPA-PSK WPA-PSK-SHA256 SAE
	ieee80211w=1
	psk="{{.Password}}"
{{- end}}
}
{{- end}}
