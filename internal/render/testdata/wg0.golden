# WireGuard settings for the VPN tunnel (wg0).
# GENERATED by rbd from internal/render/templates/wg0.conf.tmpl.
#
# This is the format of `wg setconf` (not wg-quick): only keys and the
# server. Addresses, routes and DNS are set up by rbd (internal/routing).
# This file holds RasBeacon's private key, so only root may read it.

[Interface]
PrivateKey = yAnz5TF+lXXJte14tji3zlMNq+hd2rYUIgJBgB3fBmk=

[Peer]
# The WireGuard server.
PublicKey = xTIBA5rboUvnH4htodjb6e697QjLERt1NAB4mZqp8Dg=
Endpoint = vpn.example.com:51820
# Which addresses may come back through the tunnel. RasBeacon sends
# everything through it.
AllowedIPs = 0.0.0.0/0, ::/0
# Send a small packet every 25 seconds so hotel routers keep the
# connection open and RasBeacon notices quickly if the server stops answering.
PersistentKeepalive = 25
