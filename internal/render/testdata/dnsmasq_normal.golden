# dnsmasq configuration for the RasBeacon hotspot.
# GENERATED by rbd from internal/render/templates/dnsmasq.conf.tmpl.
#
# dnsmasq does two jobs for devices on the hotspot:
#   DHCP - hands each device an IP address when it joins
#   DNS  - turns names like "rasbeacon.lan" into addresses
# Reference: https://thekelleys.org.uk/dnsmasq/docs/dnsmasq-man.html

# --- Only serve the hotspot side, never the upstream network ---
interface=br-lan
bind-interfaces
# Don't read /etc/resolv.conf or /etc/hosts: everything is configured here.
no-resolv
no-hosts

# --- DHCP: addresses for connected devices ---
# Leases last 1 hour, so devices using private/rotating MAC addresses free
# their old address quickly.
# "set:lan" labels these devices so the options below can be per network.
dhcp-range=set:lan,10.87.0.20,10.87.0.250,255.255.255.0,1h
dhcp-leasefile=/run/rbd/dnsmasq.leases
# Tell devices to use RasBeacon as their router and DNS server.
dhcp-option=tag:lan,option:router,10.87.0.1
dhcp-option=tag:lan,option:dns-server,10.87.0.1
# Answer DHCP requests immediately even for devices we have not seen before.
dhcp-authoritative

# --- DNS: local names ---
domain=lan
local=/lan/
address=/rasbeacon.lan/10.87.0.1

# --- DNS: internet names ---
# Questions about any other name are passed on to these servers.
# 127.0.0.53 is RasBeacon's own resolver (systemd-resolved), which asks the
# DNS servers the current uplink (hotel, café, ...) handed out.
# strict-order: always ask the first server, and the next only when it
# doesn't answer (the order the owner listed them in).
strict-order
server=127.0.0.53

# --- IPv6 for devices ---
# RasBeacon announces a private IPv6 network ("router advertisements").
# Devices pick their own addresses in it (SLAAC); no DHCPv6 is used, which is
# also what Android requires.
enable-ra
dhcp-range=::,constructor:br-lan,ra-only,64,1h
# Tell devices to use RasBeacon for DNS over IPv6 too ([::] = this device).
dhcp-option=option6:dns-server,[::]
# The uplink has IPv6, so devices may send IPv6 internet traffic here.
# Announce every 60 s; devices keep the route for 30 minutes.
ra-param=br-lan,60,1800
